<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#17171F"
    app:strokeWidth="1dp"
    app:strokeColor="#20FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/llTagChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_viper_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_search"
                app:tint="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvTagChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trending"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llContentArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/llTagChip">

            <TextView
                android:id="@+id/tvMainHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evening Walk"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Perfect time for a quick transition out of work. Relax and recharge."
                android:textColor="#8E8E93"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirections"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Get Directions"
            android:textAllCaps="false"
            app:cornerRadius="24dp"
            app:backgroundTint="#8B7CFF"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/llContentArea"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="24dp"/>

        <!-- Illustration Area (Refined) -->
        <View
            android:id="@+id/ivIllustration"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_viper_card"
            android:alpha="0.05"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnDirections"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
