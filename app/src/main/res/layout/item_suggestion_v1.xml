<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#17171F"
    app:strokeWidth="1dp"
    app:strokeColor="#20FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <!-- TOP ROW: Icon + Tag -->
        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_cafe"
            app:tint="#8B7CFF"
            android:padding="10dp"
            android:background="@drawable/bg_action_circle_purple"
            android:backgroundTint="#1A8B7CFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTagChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_viper_input"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="NEARBY"
            android:textColor="#8B7CFF"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/ivCategoryIcon"
            app:layout_constraintBottom_toBottomOf="@id/ivCategoryIcon"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CORE CONTENT -->
        <TextView
            android:id="@+id/tvMainHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Evening Relaxation"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineHeight="28sp"
            app:layout_constraintTop_toBottomOf="@id/ivCategoryIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSubHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kamla Cafe"
            android:textColor="#8B7CFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvMainHeading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Time for a break? Kamla Cafe is highly recommended for its peaceful atmosphere."
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubHeading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/llActions"
            app:layout_constraintVertical_bias="0"/>

        <!-- ACTION AREA -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirections"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Get Directions"
                android:textAllCaps="false"
                app:cornerRadius="24dp"
                app:backgroundTint="#8B7CFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlanHangout"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Plan Hangout"
                android:textAllCaps="false"
                android:textColor="#8B7CFF"
                app:cornerRadius="24dp"
                app:backgroundTint="#1A8B7CFF"
                app:strokeColor="#8B7CFF"
                app:strokeWidth="1dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:visibility="gone"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
