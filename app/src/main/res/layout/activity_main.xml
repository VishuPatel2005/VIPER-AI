<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viper_surface"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Nav Bar -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clipToPadding="false"
            android:paddingTop="64dp"
            android:paddingBottom="160dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp">

                <!-- Header Section -->
                <TextView
                    android:id="@+id/greetingHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Morning, "
                    android:textColor="@color/viper_on_surface"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"/>

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alexander"
                    android:textColor="@color/viper_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="-4dp"/>

                <!-- Quick Stats Pills -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/reminderChip"
                            style="@style/ViperChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_reminders"
                                app:tint="@color/viper_primary"/>
                            <TextView
                                android:id="@+id/reminderChipText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4 Reminders"
                                android:textColor="@color/viper_on_surface"
                                android:textSize="13sp"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/meetingChip"
                            style="@style/ViperChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/viper_primary"/>
                            <TextView
                                android:id="@+id/meetingChipText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 Meetings"
                                android:textColor="@color/viper_on_surface"
                                android:textSize="13sp"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- LIVE SUGGESTIONS SECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp"
                    android:gravity="bottom">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Live Suggestions"
                        android:textColor="@color/viper_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/suggestionsViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:clipChildren="false" />

                <!-- Upcoming Event Section (Hidden Anchor) -->
                <LinearLayout
                    android:id="@+id/calendarLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp"
                    android:gravity="bottom">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Upcoming Event"
                        android:textColor="@color/viper_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nextEventCard"
                    style="@style/ViperCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <include layout="@layout/layout_event_content" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Reminders Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp"
                    android:gravity="bottom">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reminders"
                        android:textColor="@color/viper_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/viewAllReminders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all"
                        android:textColor="@color/viper_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reminderListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_viper_card"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"/>

                <!-- Notes Section -->
                <LinearLayout
                    android:id="@+id/notesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp"
                    android:gravity="bottom">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Notes"
                        android:textColor="@color/viper_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all"
                        android:textColor="@color/viper_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/latestNoteCard"
                    style="@style/ViperCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_viper_chip"
                            android:gravity="center"
                            android:layout_marginBottom="16dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_notes"
                                app:tint="@color/viper_primary"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNoNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No notes yet"
                            android:textColor="@color/viper_on_surface_variant"
                            android:textSize="16sp"
                            android:gravity="center_vertical"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/noteTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/viper_on_surface"
                            android:textSize="17sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/notePreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/viper_on_surface_variant"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"
                            android:maxLines="2"
                            android:ellipsize="end"/>
                        <TextView
                            android:id="@+id/noteTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/viper_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginTop="16dp"
                            android:alpha="0.6"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/healthLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Health Summary"
                        android:textColor="@color/viper_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/viewAllHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all"
                        android:textColor="@color/viper_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/healthSummaryCard"
                    style="@style/ViperCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <!-- Left: Medication Tracker -->
                        <LinearLayout
                            android:id="@+id/medicationSection"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            
                            <FrameLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="center">
                                <ProgressBar
                                    android:id="@+id/dosageProgressBar"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/circle_progress_background"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/circle_progress" />
                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_pill"
                                    app:tint="@color/viper_primary"/>
                            </FrameLayout>

                            <TextView
                                android:id="@+id/dosageStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- / --"
                                android:textColor="@color/viper_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medication"
                                android:textColor="@color/viper_on_surface_variant"
                                android:textSize="10sp"
                                app:textAllCaps="true"
                                android:letterSpacing="0.1"/>
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="80dp"
                            android:background="@color/viper_outline"
                            android:alpha="0.1"
                            android:layout_marginHorizontal="8dp"/>

                        <!-- Right: Period Tracker -->
                        <LinearLayout
                            android:id="@+id/periodSection"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            
                            <FrameLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="center">
                                <ProgressBar
                                    android:id="@+id/periodProgressBar"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/circle_progress_background"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/circle_progress"
                                    android:progressTint="@color/viper_error"/>
                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_calendar"
                                    app:tint="@color/viper_error"/>
                            </FrameLayout>

                            <TextView
                                android:id="@+id/periodStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/viper_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cycle"
                                android:textColor="@color/viper_on_surface_variant"
                                android:textSize="10sp"
                                app:textAllCaps="true"
                                android:letterSpacing="0.1"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Top Nav Bar MUST BE AFTER scrollView in XML to stay on top -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="0dp"
            android:background="@color/viper_surface"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/menuButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/viper_on_surface"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Viper"
                android:textColor="@color/viper_on_surface"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"/>

            <ImageView
                android:id="@+id/globeButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_globe"
                app:tint="@color/viper_on_surface"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/you"
                android:background="@android:color/transparent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                app:strokeColor="@color/viper_outline"
                app:strokeWidth="1dp"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <!-- Chat Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="0dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_viper_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/uploadButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/viper_on_surface_variant"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"/>

                <EditText
                    android:id="@+id/textInputBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Ask Viper anything..."
                    android:textColor="@color/viper_on_surface"
                    android:textColorHint="@color/viper_on_surface_variant"
                    android:textSize="15sp"
                    android:layout_marginStart="8dp"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:singleLine="true"/>

                <ImageView
                    android:id="@+id/micButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/viper_on_surface_variant"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/sendButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_send"
                    android:background="@drawable/bg_viper_chip"
                    android:backgroundTint="@color/viper_primary"
                    app:tint="@color/white"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/viper_surface"
        app:itemTextColor="@color/viper_on_surface"
        app:itemIconTint="@color/viper_primary">
        <include layout="@layout/layout_sidebar_drawer" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
