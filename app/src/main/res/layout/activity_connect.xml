<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#0B0B0E"
    tools:context=".ConnectActivity">

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- DASHBOARD VIEW (Index 0) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp"
            android:clipToPadding="false"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="40dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/dashboardProfileImage"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_person"
                        app:shapeAppearanceOverlay="@style/CircleAppearance" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connect"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See where your friends are"
                            android:textColor="#8E8E93"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SEARCH BAR -->
                <LinearLayout
                    android:id="@+id/dashboardSearchBar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_unified_search_modern"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="#A0A0A0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search users / people"
                        android:textColor="#707070"
                        android:textSize="16sp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- FRIEND REQUESTS CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFriendRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#17171F"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Friend Requests"
                            android:textColor="#FF9F0A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvFriendRequests"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- BENTO CARDS GRID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">

                    <!-- CARD 1: YOUR LOCATION -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardLocation"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#17171F">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/bg_map_placeholder_dark"
                                android:scaleType="centerCrop" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_location_card_overlay" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="YOUR LOCATION"
                                    android:textColor="#8B7CFF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.1" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="4dp">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ic_navigation_arrow"
                                        app:tint="#8B7CFF" />

                                    <TextView
                                        android:id="@+id/tvCurrentLocationName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Locating..."
                                        android:textColor="#FFFFFF"
                                        android:textSize="24sp"
                                        android:layout_marginStart="8dp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CARD 2: CHATS -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardChats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#17171F">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Chats"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvViewAllChats"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="VIEW ALL"
                                    android:textColor="#A07CFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true"/>
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvChatPreview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:nestedScrollingEnabled="false" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- SHARED EXPENSES CARD -->
                    <include layout="@layout/layout_connect_expense_card" />

                    <!-- CARD 3: FRIENDS NEARBY -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFriendsNearby"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#17171F">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Friends nearby"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvFriendsHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CARD 4: SUGGESTED PLACES -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardSuggestedPlaces"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#17171F">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Suggested places"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:columnCount="2"
                                android:rowCount="2">

                                <LinearLayout
                                    android:id="@+id/catCafe"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="8dp"
                                    android:background="@drawable/bg_category_square"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_cafe"
                                        app:tint="#A07CFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Cafe"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/catGym"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="8dp"
                                    android:background="@drawable/bg_category_square"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_gym"
                                        app:tint="#A07CFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Gym"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/catEat"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="8dp"
                                    android:background="@drawable/bg_category_square"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_food"
                                        app:tint="#A07CFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Eat"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/catStudy"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="8dp"
                                    android:background="@drawable/bg_category_square"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_notes"
                                        app:tint="#A07CFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Study"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </GridLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CARD 5: QUICK ACTIONS -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardQuickActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#17171F">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quick Actions"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="16dp"
                                android:gravity="center">

                                <LinearLayout
                                    android:id="@+id/btnShareLive"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:background="@drawable/bg_action_circle_purple"
                                        android:src="@drawable/ic_navigation_arrow"
                                        android:padding="16dp"
                                        app:tint="#FFFFFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="SHARE\nLIVE"
                                        android:textColor="#8E8E93"
                                        android:textSize="10sp"
                                        android:textAlignment="center"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnNewChatDashboard"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:background="@drawable/bg_action_circle_dark"
                                        android:src="@drawable/ic_contacts"
                                        android:padding="16dp"
                                        app:tint="#FFFFFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="NEW\nCHAT"
                                        android:textColor="#8E8E93"
                                        android:textSize="10sp"
                                        android:textAlignment="center"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnFindNearbyDashboard"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <ImageView
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:background="@drawable/bg_action_circle_dark"
                                        android:src="@drawable/ic_navigation_arrow"
                                        android:padding="16dp"
                                        app:tint="#FFFFFF" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="FIND\nNEARBY"
                                        android:textColor="#8E8E93"
                                        android:textSize="10sp"
                                        android:textAlignment="center"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- FULL MAP VIEW (Index 1 - Reusing content) -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/mapLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/mapWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#0B0B0E" />

                <!-- MAP CONTROLS -->
                <ImageView
                    android:id="@+id/btnMyLocation"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_map_control"
                    android:src="@drawable/ic_navigation_arrow"
                    android:padding="12dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="136dp"
                    android:elevation="4dp"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/btnCloseMap"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_map_control"
                        android:src="@drawable/ic_back"
                        android:padding="12dp"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:id="@+id/mapSearchBar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_map_search_modern"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search"
                            app:tint="#A0A0A0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search places..."
                            android:textColor="#A0A0A0"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnCategoryFilter"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_map_control"
                        android:src="@drawable/ic_filter"
                        android:padding="12dp"
                        android:elevation="4dp"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- HANGOUT SUGGESTION CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/suggestionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="80dp"
                    android:layout_marginHorizontal="16dp"
                    app:cardBackgroundColor="#1E1E24"
                    app:cardCornerRadius="16dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🔥 Hangout Suggestion"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/btnDismissSuggestion"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="#808080" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/suggestionSubtitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#A0A0A0"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                        <LinearLayout
                            android:id="@+id/placesListContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- BOTTOM SHEET (Reusing logic) -->
            <LinearLayout
                android:id="@+id/bottomSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sheet_modern"
                android:orientation="vertical"
                app:behavior_peekHeight="120dp"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
                app:behavior_hideable="false">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:background="#30FFFFFF"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="40dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Friends nearby"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/friendsNearbySummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seeing 0 friends active"
                            android:textColor="#808080"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="24dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/friendsRecyclerViewMap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/emptyFriendsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="See where your friends are heading"
                            android:textColor="#404040"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="32dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </ViewFlipper>

    <!-- UNIFIED SEARCH OVERLAY (Reusing) -->
    <LinearLayout
        android:id="@+id/searchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B0B0E"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#0B0B0E"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnSearchBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:padding="6dp"
                app:tint="@color/white" />

            <EditText
                android:id="@+id/fullSearchEditText"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input_modern"
                android:hint="Search users / people"
                android:textColor="@color/white"
                android:textColorHint="#404040"
                android:textSize="18sp"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />
            
            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="#606060"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchSuggestionsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- EXPENSE FRAGMENT CONTAINER -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerConnect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="25dp" />
</FrameLayout>
