<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dashboard_card"
    android:padding="16dp"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">
    
    <!-- Original Reminder Layout -->
    <LinearLayout
        android:id="@+id/reminderMainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:id="@+id/reminderCheckBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_circle_outline"
            app:tint="@color/text_secondary" 
            android:clickable="true"
            android:focusable="true" />
        
        <TextView
            android:id="@+id/reminderText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reminder text"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Completion Layout (Hidden by default) -->
    <LinearLayout
        android:id="@+id/reminderCompletionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder completed"
            android:textColor="@color/step_green"
            android:textSize="16sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/undoReminderBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Undo"
            android:textColor="@color/water_blue"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp" />
    </LinearLayout>
    
</LinearLayout>
