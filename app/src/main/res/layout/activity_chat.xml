<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ChatActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->
        <LinearLayout
            android:id="@+id/chat_top_bar"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VIPER"
                android:textColor="@color/purple_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <ImageView
                android:id="@+id/chat_back_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:padding="4dp"
                android:contentDescription="@string/back"
                android:tint="@color/white" />

        </LinearLayout>

        <!-- Messages list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/chat_top_bar"
            app:layout_constraintBottom_toTopOf="@id/chat_input_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_chat_user" />

        <!-- Input bar -->
        <LinearLayout
            android:id="@+id/chat_input_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_viper_input"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/chat_input_field"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Talk to Viper..."
                android:textColor="@color/white"
                android:textColorHint="@color/text_input_hint"
                android:paddingHorizontal="12dp"
                android:imeOptions="actionSend"
                android:singleLine="true"
                android:inputType="text" />

            <ImageView
                android:id="@+id/chat_mic_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dashboard_chip"
                android:padding="10dp"
                android:src="@drawable/ic_mic"
                android:tint="@color/purple_accent"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/voice_search" />

            <ImageView
                android:id="@+id/chat_send_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dashboard_chip"
                android:padding="8dp"
                android:src="@drawable/ic_send"
                android:tint="@color/purple_accent"
                android:contentDescription="@string/send" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer Content -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/chatNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start">
        <include layout="@layout/layout_sidebar_drawer" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
