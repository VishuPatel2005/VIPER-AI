<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_exit</item>
    </style>

    <style name="MaterialDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/purple_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorAccent">@color/purple_accent</item>
    </style>

    <style name="MaterialAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/purple_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>

    <!-- CalendarView text colors for dark background -->
    <style name="CalendarWeekDayText" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">#8A8A8E</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarDateText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.App.DarkPopupMenu" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="popupMenuStyle">@style/GlassPopupMenu</item>
        <item name="android:popupMenuStyle">@style/GlassPopupMenu</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="GlassPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_glass_popup</item>
    </style>

    <!-- Premium Authentication Styles -->
    <style name="AuthInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">

        <item name="boxStrokeColor">@color/auth_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/auth_input_bg</item>
        <item name="hintTextColor">@color/auth_primary</item>
        <item name="android:textColorHint">@color/auth_text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="AuthPrimaryButton" parent="Widget.MaterialComponents.Button">

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Rounded12</item>
        <item name="android:backgroundTint">@color/auth_primary</item>
        <item name="android:textColor">@color/auth_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="AuthHeaderTitle">
        <item name="android:textColor">@color/auth_text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="AuthHeaderSubtitle">
        <item name="android:textColor">@color/auth_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="ShapeAppearance.App.Rounded12" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleAppearance" parent="ShapeAppearance.App.Circle" />

    <style name="DashboardCardTitle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/auth_bg_bottom</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/BottomSheetShapeAppearance</item>
        <item name="backgroundTint">@color/auth_bg_bottom</item>
    </style>

    <style name="BottomSheetShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="SnapFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>