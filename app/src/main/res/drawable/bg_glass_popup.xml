<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Translucent dark background (approx 70% opacity for liquid glass effect) -->
    <solid android:color="#B31E1E24" />
    <corners android:radius="16dp" />
    <!-- Light glowing border to signify refraction/glass edge -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
